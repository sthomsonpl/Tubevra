{
  "name": "tubevra",
  "productName": "Tubevra",
  "version": "0.1.2-alpha",
  "private": true,
  "description": "Unofficial desktop YouTube client with TV and Desktop modes",
  "author": "sthomsonpl",
  "keywords": [],
  "license": "GPL-3.0-only",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test:core": "node --test tests/core.test.cjs",
    "test:tv-display": "node --test tests/tv-display.test.cjs",
    "test:adblock": "node --test tests/adblock.test.cjs",
    "test:ui": "node tests/electron/run.cjs ui-smoke",
    "test:glass": "node tests/electron/run.cjs glass-probe",
    "test:extensions": "node --test tests/extensions.test.cjs tests/extension-build.test.mjs",
    "test:runtime": "node --test tests/runtime.test.cjs tests/hooks.test.cjs",
    "test:hooks:electron": "node tests/build-hooks.mjs && node tests/electron/run.cjs hooks-smoke && node tests/electron/run.cjs hooks-bootstrap-smoke",
    "test:runtime:electron": "node tests/build-runtime.mjs && node tests/electron/run.cjs runtime-smoke",
    "test:hooks:packaged": "node tests/packaged-hooks.mjs",
    "test:adblock:electron": "node tests/build-adblock.mjs && node tests/electron/run.cjs adblock-smoke",
    "test:adblock:packaged": "node tests/packaged-hooks.mjs --adblock"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-base": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "app-builder-lib": "^26.15.3",
    "electron": "45.0.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
